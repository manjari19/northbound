# Copy this file to .env (same folder) and fill in what you want. .env is never committed.

# Email alerts (Gmail). SMTP_PASSWORD is a Gmail *app password*, not your normal password:
# myaccount.google.com/apppasswords (needs 2-Step Verification on). Spaces are fine.
EMAIL_TO=
SMTP_USER=
SMTP_PASSWORD=
# Only change these for a non-Gmail account
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Text messages through Twilio (leave blank to skip)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ALERT_TO=

# Discord channel webhook (optional)
DISCORD_WEBHOOK_URL=

# macOS banner notifications from the 5-minute loop. 1 = on, 0 = off
NB_NOTIFY=1

# ResumeRadar fit checks: written for you by resumeradar/scripts/analyse-url.sh.
# A Lambda Function URL skips API Gateway's 29 second cap. Lives in .env.local.
# NEXT_PUBLIC_RADAR_ANALYSE_URL=
